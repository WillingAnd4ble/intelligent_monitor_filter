# FastAPI base URL (no trailing slash). Required for API calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: shown in sidebar / account stub.
NEXT_PUBLIC_DEMO_EMAIL=you@research.example

# Optional: if the backend sets a named session cookie on your app domain,
# set it so middleware can guard /dashboard, /library, /terminal, /feed.
# Leave unset during local dev if cookies are cross-origin only — axios 401 redirect still applies.
# AUTH_SESSION_COOKIE_NAME=access_token
