# Required
JWT_SECRET=change-me-to-a-random-string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/arxiv_filter
REDIS_URL=redis://localhost:6379/0

# AI APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Modal GPU (set True to use real GPU inference)
MODAL_GPU_ENABLED=False
# Only needed if NOT using ~/.modal.toml auth:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Notifications (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=